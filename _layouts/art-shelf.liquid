---
layout: page
---
{{ content }}

<div class="art-portfolio">

<!-- Filter Controls -->


<div class="art-portfolio-layout">
  <!-- Category Sidebar -->
  {% assign all_categories = site.art | map: 'categories' | compact | flatten %}
  {% assign downcase_categories = '' | split: ',' %}
  {% for category in all_categories %}
    {% assign downcase_category = category | downcase %}
    {% assign downcase_categories = downcase_categories | push: downcase_category %}
  {% endfor %}
  {% assign unique_categories = downcase_categories | uniq %}
  
  {% comment %} Organize categories hierarchically {% endcomment %}
  {% assign parent_categories = '' | split: ',' %}
  {% assign category_map = '' | split: ',' %}
  
  {% for category in unique_categories %}
    {% if category contains '/' %}
      {% assign parts = category | split: '/' %}
      {% assign parent = parts[0] %}
      {% assign subcategory = category %}
      
      {% unless parent_categories contains parent %}
        {% assign parent_categories = parent_categories | push: parent %}
      {% endunless %}
    {% else %}
      {% unless parent_categories contains category %}
        {% assign parent_categories = parent_categories | push: category %}
      {% endunless %}
    {% endif %}
  {% endfor %}
  
  {% comment %} Sort parent categories alphabetically {% endcomment %}
  {% assign parent_categories = parent_categories | sort %}
  
  {% comment %} Define color palette for parent categories {% endcomment %}
  {% assign category_colors = '#3b82f6,#8b5cf6,#ec4899,#10b981,#06b6d4,#ef4444,#6366f1' | split: ',' %}
  
  {% comment %} Count artworks for each category {% endcomment %}
  {% assign collection = site[page.collection] %}
  {% assign all_count = 0 %}
  {% if collection and collection.size > 0 %}
    {% assign all_count = collection.size %}
  {% endif %}
  
  {% if unique_categories.size > 0 %}
  <div class="category-sidebar">
    <div class="filter-group">
      <h3>Categories</h3>
      <div class="filter-buttons">
        <button class="filter-btn active" data-filter-type="category" data-filter="all" data-filter-mode="exact" data-parent-category="">all ({{ all_count }})</button>
        {% for parent in parent_categories %}
          {% assign parent_index = forloop.index0 | modulo: category_colors.size %}
          {% assign parent_color = category_colors[parent_index] %}
          {% assign has_subcategories = false %}
          {% for category in unique_categories %}
            {% if category contains '/' %}
              {% assign parts = category | split: '/' %}
              {% if parts[0] == parent %}
                {% assign has_subcategories = true %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}
          
          {% comment %} Count artworks for parent category {% endcomment %}
          {% assign parent_count = 0 %}
          {% if collection and collection.size > 0 %}
            {% for item in collection %}
              {% assign item_matched = false %}
              {% if item.categories %}
                {% for item_category in item.categories %}
                  {% assign item_cat_downcase = item_category | downcase %}
                  {% if item_cat_downcase == parent %}
                    {% assign item_matched = true %}
                    {% break %}
                  {% elsif item_cat_downcase contains '/' %}
                    {% assign item_parts = item_cat_downcase | split: '/' %}
                    {% if item_parts[0] == parent %}
                      {% assign item_matched = true %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {% if item_matched %}
                {% assign parent_count = parent_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}
          
          {% if has_subcategories %}
            {% comment %} Parent category with subcategories - dropdown {% endcomment %}
            <div class="category-dropdown">
              <button class="filter-btn filter-btn-parent filter-btn-toggle expanded" data-filter-type="category" data-filter="{{ parent | slugify }}" data-filter-mode="parent" data-parent-category="{{ parent | slugify }}" style="--category-color: {{ parent_color }};">
                <span class="dropdown-arrow">▶</span>
                <span class="category-text">{{ parent }} ({{ parent_count }})</span>
              </button>
              <div class="category-dropdown-content" style="display: flex;">
                {% comment %} Collect subcategories for this parent {% endcomment %}
                {% assign parent_subcategories = '' | split: ',' %}
                {% for category in unique_categories %}
                  {% if category contains '/' %}
                    {% assign parts = category | split: '/' %}
                    {% if parts[0] == parent %}
                      {% assign parent_subcategories = parent_subcategories | push: category %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
                {% comment %} Sort subcategories alphabetically {% endcomment %}
                {% assign parent_subcategories = parent_subcategories | sort %}
                {% for category in parent_subcategories %}
                  {% assign parts = category | split: '/' %}
                  {% comment %} Count artworks for this subcategory {% endcomment %}
                  {% assign subcategory_count = 0 %}
                  {% if collection and collection.size > 0 %}
                    {% for item in collection %}
                      {% if item.categories %}
                        {% for item_category in item.categories %}
                          {% assign item_cat_downcase = item_category | downcase %}
                          {% if item_cat_downcase == category %}
                            {% assign subcategory_count = subcategory_count | plus: 1 %}
                            {% break %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% comment %} Remove parent from display - show remaining parts with leading slash {% endcomment %}
                  {% assign subcategory_parts = '' | split: ',' %}
                  {% for i in (1..parts.size) %}
                    {% assign idx = i | minus: 1 %}
                    {% if idx > 0 %}
                      {% assign subcategory_parts = subcategory_parts | push: parts[idx] %}
                    {% endif %}
                  {% endfor %}
                  {% assign subcategory_display = subcategory_parts | join: '/' | prepend: '/' %}
                  <button class="filter-btn filter-btn-subcategory" data-filter-type="category" data-filter="{{ category | slugify }}" data-filter-mode="exact" data-parent-category="{{ parent | slugify }}" style="--category-color: {{ parent_color }};">{{ subcategory_display }} ({{ subcategory_count }})</button>
                {% endfor %}
              </div>
            </div>
          {% else %}
            {% comment %} Standalone category (no subcategories) {% endcomment %}
            <button class="filter-btn" data-filter-type="category" data-filter="{{ parent | slugify }}" data-filter-mode="exact" data-parent-category="{{ parent | slugify }}" style="--category-color: {{ parent_color }};">{{ parent }} ({{ parent_count }})</button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- Art Grid -->
  <div class="art-grid">
{% assign year = '' %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% assign sorted_collection = collection | sort: "date" | reverse %}
    {% for item in sorted_collection %}
      {% assign current_year = item.date | date: "%Y" %}
      {% if current_year != year %}
        <h1>{{ current_year }}</h1>
        {% assign year = current_year %}
      {% endif %}
      <figure class="artwork-cover" 
              data-medium="{{ item.medium | downcase | slugify | default: 'unknown' }}"
              data-categories="{% if item.categories %}{% for category in item.categories %}{{ category | downcase | slugify }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}"
              data-tags="{% if item.tags %}{% for tag in item.tags %}{{ tag | downcase | slugify }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}">
        <a class="artwork-link" href="{{ item.url | relative_url }}">
          <div class="artwork-thumbnail-container">
            {% if item.image %}
              {% if item.image contains 'assets/img/' %}
                {% assign image_path = item.image %}
              {% else %}
                {% assign image_path = item.image | prepend: 'assets/img/' %}
              {% endif %}
              <img alt="{{ item.title }} artwork" src="{{ image_path | relative_url }}" class="artwork-thumbnail">
            {% else %}
              <div class="artwork-placeholder">
                <i class="fa-solid fa-image fa-2x"></i>
              </div>
            {% endif %}
            {% assign item_content = item.content | strip %}
            {% assign has_images = false %}
            {% if item_content != '' and item_content.size > 0 %}
              {% if item_content contains '<img' or item_content contains '![[' or item_content contains '![' %}
                {% assign has_images = true %}
              {% endif %}
            {% endif %}
            {% if has_images %}
              <div class="artwork-gallery-icon">
                <i class="fa-solid fa-images"></i>
              </div>
            {% endif %}
            {% if item_content != '' and item_content.size > 0 %}
              <div class="artwork-comment-icon">
                <i class="fa-solid fa-comment"></i>
              </div>
            {% endif %}
          </div>
          {% if item.featured %}
            <figcaption class="featured">FEATURED</figcaption>
          {% endif %}
        </a>
      </figure>
    {% endfor %}
  {% endif %}
  </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Filter functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const artworkItems = document.querySelectorAll('.artwork-cover');
  const yearHeaders = document.querySelectorAll('.art-grid h1');

  // Track active filters for each type
  let activeFilters = {
    medium: 'all',
    category: 'all',
    categoryMode: 'exact',
    tag: 'all'
  };

  function updateActiveButtons(filterType, filterValue) {
    // Update active button for the specific filter type
    const buttonsOfType = document.querySelectorAll(`[data-filter-type="${filterType}"]`);
    buttonsOfType.forEach(btn => {
      btn.classList.remove('active');
      if (btn.getAttribute('data-filter') === filterValue) {
        btn.classList.add('active');
      }
    });
  }

  function shouldShowItem(item) {
    // Check medium filter
    if (activeFilters.medium !== 'all') {
      const itemMedium = item.getAttribute('data-medium');
      if (itemMedium !== activeFilters.medium) {
        return false;
      }
    }

    // Check category filter
    if (activeFilters.category !== 'all') {
      const itemCategories = item.getAttribute('data-categories');
      const filterMode = activeFilters.categoryMode || 'exact';
      
      if (!itemCategories) {
        return false;
      }
      
      const categoryArray = itemCategories.split(',').filter(c => c.trim() !== '');
      
      if (filterMode === 'parent') {
        // Parent mode: show all items with categories starting with parent/
        // or exactly matching the parent
        // Note: slugify converts "/" to "-", so we need to check for both
        const parentSlug = activeFilters.category;
        const matches = categoryArray.some(cat => {
          const catSlug = cat.trim();
          // Check if category is exactly the parent, or starts with parent/ or parent-
          return catSlug === parentSlug || 
                 catSlug.startsWith(parentSlug + '/') || 
                 catSlug.startsWith(parentSlug + '-');
        });
        if (!matches) {
          return false;
        }
      } else {
        // Exact mode: show only items with exact category match
        if (!categoryArray.includes(activeFilters.category)) {
          return false;
        }
      }
    }

    // Check tag filter
    if (activeFilters.tag !== 'all') {
      const itemTags = item.getAttribute('data-tags');
      if (!itemTags || !itemTags.split(',').includes(activeFilters.tag)) {
        return false;
      }
    }

    return true;
  }

  function updateYearHeaders() {
    yearHeaders.forEach(header => {
      // Count visible artwork in this year section
      let visibleArtwork = 0;
      let currentElement = header.nextElementSibling;
      
      // Count artwork until we hit the next year header or end of grid
      while (currentElement && currentElement.tagName !== 'H1') {
        if (currentElement.classList.contains('artwork-cover') && 
            currentElement.style.display !== 'none' && 
            currentElement.style.opacity !== '0') {
          visibleArtwork++;
        }
        currentElement = currentElement.nextElementSibling;
      }
      
      // Show/hide year header based on visible artwork
      if (visibleArtwork === 0) {
        header.style.display = 'none';
      } else {
        header.style.display = 'block';
      }
    });
  }

  function applyFilters() {
    // Use requestAnimationFrame for smoother animations
    requestAnimationFrame(() => {
      artworkItems.forEach(item => {
        const shouldShow = shouldShowItem(item);
        
        if (shouldShow) {
          item.style.display = 'block';
          item.style.opacity = '0';
          item.style.transition = 'opacity 0.2s ease';
          requestAnimationFrame(() => {
            item.style.opacity = '1';
          });
        } else {
          item.style.opacity = '0';
          item.style.transition = 'opacity 0.2s ease';
          setTimeout(() => {
            if (item.style.opacity === '0') {
              item.style.display = 'none';
            }
          }, 200);
        }
      });
      
        // Update year headers after a delay to allow opacity transitions
        setTimeout(updateYearHeaders, 250);
    });
  }

  if (filterButtons.length > 0 && artworkItems.length > 0) {
    filterButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        const filterType = this.getAttribute('data-filter-type');
        const filterValue = this.getAttribute('data-filter');
        const filterMode = this.getAttribute('data-filter-mode') || 'exact';
        
        // Handle dropdown toggle for parent categories
        if (this.classList.contains('filter-btn-toggle')) {
          const dropdown = this.closest('.category-dropdown');
          const content = dropdown.querySelector('.category-dropdown-content');
          const isExpanded = this.classList.contains('expanded');
          
          if (isExpanded) {
            this.classList.remove('expanded');
            content.style.display = 'none';
          } else {
            this.classList.add('expanded');
            content.style.display = 'flex';
          }
        }
        
        // Update active filters
        activeFilters[filterType] = filterValue;
        if (filterType === 'category') {
          activeFilters.categoryMode = filterMode;
        }
        
        // Update active buttons
        updateActiveButtons(filterType, filterValue);
        
        // Apply filters
        applyFilters();
      });
    });
  }
});
</script>